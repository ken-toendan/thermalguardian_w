{
  // Cloudflare Worker that serves the built site (webapp/dist) as assets.
  // Workers Builds runs `npm run build` then `npx wrangler deploy` from webapp/.
  "name": "thermalguardian-w",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./dist"
  },
  // Required by `npx wrangler preview` (the default Preview command for
  // non-production branches). Empty: previews need no separate settings.
  "previews": {}
}
